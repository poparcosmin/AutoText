# AutoText Django Configuration
# Copy this file to .env and update the values

# =============================================================================
# REQUIRED - Must be set in production
# =============================================================================

# Django secret key - MUST be unique and kept secret in production
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-secret-key-change-in-production

# Debug mode - MUST be False in production
DEBUG=True

# =============================================================================
# HOSTS - Configure based on your deployment
# =============================================================================

# Allowed hosts for development (comma-separated)
ALLOWED_HOSTS_DEBUG=localhost,127.0.0.1

# Allowed hosts for production (comma-separated)
ALLOWED_HOSTS_PROD=autotext.zua.ro

# =============================================================================
# CACHE - Redis configuration
# =============================================================================

# Redis URL for caching
# Format: redis://[:password]@host:port/db_number
REDIS_URL=redis://127.0.0.1:6379/1

# =============================================================================
# APPLICATION
# =============================================================================

# Application version (shown in health check endpoint)
APP_VERSION=1.0.0
