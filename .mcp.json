{
  "mcpServers": {
    "c7": {
      "command": "/home/cosmin/.local/bin/env-run",
      "args": [
        "/home/cosmin/.secrets",
        "--",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "DOCUMENTATION_SOURCES": "django,python,javascript,bootstrap,redis,pnpm,nodejs,htmx",
        "CONTEXT_NAMESPACE": "dev_documentation",
        "AUTO_UPDATE": "true",
        "UPDATE_FREQUENCY": "daily",
        "CACHE_DURATION": "604800"
      }
    },
    "cdt": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "fs": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/cosmin/Work/The_Project"
      ]
    },
    "qdrant": {
      "command": "python3",
      "args": [
        "/home/cosmin/Work/LangChain-Qdrant/mcp_server/memory_server.py"
      ],
      "env": {
        "MEMORY_API_URL": "http://localhost:8100"
      }
    }
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  }
}
