{
  "manifest_version": 3,
  "name": "AutoText - Text Expansion",
  "version": "1.2.0",
  "description": "Seamless text expansion system - type shortcuts and press Tab to expand",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "AutoText - Quick Actions"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "sync-shortcuts": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Sync shortcuts from server"
    },
    "toggle-autotext": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Toggle AutoText on/off"
    },
    "open-options": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Open AutoText options"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open AutoText popup"
    }
  }
}
